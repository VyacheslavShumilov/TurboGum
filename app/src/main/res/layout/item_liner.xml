<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_surface_2"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_1"
    app:strokeWidth="@dimen/stroke_default"
    app:rippleColor="#221E2235">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image area -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:shimmer_auto_start="true"
                app:shimmer_base_color="#1E2235"
                app:shimmer_duration="1000"
                app:shimmer_highlight_color="#2A2D45">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@color/bg_surface_2" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <ImageView
                android:id="@+id/linerImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Rarity badge top-left -->
            <TextView
                android:id="@+id/rarityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/spacing_sm"
                android:background="@drawable/badge_rarity_common"
                android:fontFamily="@font/space_grotesk"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_1"
                android:textFontWeight="600"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                tools:text="Rare" />

            <!-- Favourite button top-right -->
            <ImageButton
                android:id="@+id/btnFavourite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/spacing_sm"
                android:background="@android:color/transparent"
                android:contentDescription="Favourite"
                android:padding="4dp"
                android:src="@drawable/ic_favorite_border" />

        </FrameLayout>

        <!-- Card body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_md">

            <TextView
                android:id="@+id/linerBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_body_sm"
                tools:text="Opel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/linerModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    android:textSize="14sp"
                    android:textStyle="italic|bold"
                    tools:text="Ascona CD" />

                <TextView
                    android:id="@+id/linerNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:fontFamily="@font/barlow_condensed"
                    android:textColor="@color/brand_gold"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="#001" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>