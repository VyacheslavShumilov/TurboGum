<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/bg_surface_2"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_1"
    app:strokeWidth="@dimen/stroke_default"
    app:rippleColor="#221E2235">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image area — fixed 120dp so shimmer and image occupy same space -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <!-- Shimmer shown while image loads -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:shimmer_auto_start="true"
                app:shimmer_base_color="#1A1B2E"
                app:shimmer_highlight_color="#3D3F6B"
                app:shimmer_duration="1200">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#1A1B2E" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Sticker image — hidden until Picasso delivers -->
            <ImageView
                android:id="@+id/linerImageView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Rarity colour dot (no text label) top-left -->
            <View
                android:id="@+id/rarityBadge"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/spacing_sm"
                android:background="@drawable/badge_rarity_common" />

            <!-- Favourite button top-right -->
            <ImageButton
                android:id="@+id/btnFavourite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/spacing_sm"
                android:background="@android:color/transparent"
                android:contentDescription="Favourite"
                android:padding="4dp"
                android:src="@drawable/ic_favorite_border" />

        </FrameLayout>

        <!-- Card body: brand / model / number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_md">

            <!-- Brand — brighter so it's visible -->
            <TextView
                android:id="@+id/linerBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:textColor="@color/text_2"
                android:textSize="@dimen/text_body_sm"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                tools:text="OPEL" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/linerModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_condensed"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    android:textSize="14sp"
                    android:textStyle="italic|bold"
                    tools:text="Ascona CD" />

                <TextView
                    android:id="@+id/linerNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:fontFamily="@font/barlow_condensed"
                    android:textColor="@color/brand_gold"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="#001" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>