<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_sm">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/space_grotesk_semibold"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/text_3"
        android:textSize="@dimen/text_label_md" />

    <TextView
        android:id="@+id/sectionAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_grotesk_semibold"
        android:textColor="@color/brand_violet_light"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>