<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_background"
    tools:context=".ui.liners_lists.LinersListFragment">

    <!-- Detail header with back/title/more -->
    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_detail_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/header_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl">

            <!-- Series number/title -->
            <TextView
                android:id="@+id/seriesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/barlow_condensed"
                android:textColor="@color/brand_gold"
                android:textSize="36sp"
                android:textStyle="italic|bold"
                android:letterSpacing="-0.02"
                tools:text="Серия 1" />

            <TextView
                android:id="@+id/seriesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_body_md"
                tools:text="№ 1–50 · 1989" />

            <!-- ── Progress card ────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/progressCardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <include
                    android:id="@+id/progressCard"
                    layout="@layout/component_progress_card" />
            </FrameLayout>

            <!-- ── Search field ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_field_height"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/surface_input_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_3" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/space_grotesk"
                    android:hint="@string/series_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_1"
                    android:textColorHint="@color/text_3"
                    android:textSize="@dimen/text_body_lg" />
            </LinearLayout>

            <!-- ── Filter chips ─────────────────────────────────── -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:chipSpacingHorizontal="@dimen/spacing_sm"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:checkable="true"
                    android:checked="true"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/series_filter_all"
                    android:textSize="@dimen/text_body_md"
                    app:chipBackgroundColor="@color/bg_surface_1"
                    app:chipStrokeColor="@color/border_1"
                    app:chipStrokeWidth="0.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOwned"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:checkable="true"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/series_filter_owned"
                    android:textSize="@dimen/text_body_md"
                    app:chipBackgroundColor="@color/bg_surface_1"
                    app:chipStrokeColor="@color/border_1"
                    app:chipStrokeWidth="0.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMissing"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:checkable="true"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/series_filter_missing"
                    android:textSize="@dimen/text_body_md"
                    app:chipBackgroundColor="@color/bg_surface_1"
                    app:chipStrokeColor="@color/border_1"
                    app:chipStrokeWidth="0.5dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- ── Sticker grid ─────────────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>