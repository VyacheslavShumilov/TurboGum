<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_background"
    tools:context=".ui.profile.ProfileFragment">

    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_app_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/header_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl">

            <!-- Title -->
            <TextView
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/barlow_condensed"
                android:text="@string/profile_title"
                android:textColor="@color/text_1"
                android:textSize="36sp"
                android:textStyle="italic|bold"
                android:letterSpacing="-0.02"
                android:paddingEnd="15dp" />

            <!-- Avatar + name (без подзаголовка Société Turbo) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/surface_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="@dimen/spacing_md">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_violet_gradient"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_baseline_self_improvement_24"
                        app:shapeAppearanceOverlay="@style/circleImageView"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed"
                    android:text="Коллекционер"
                    android:textColor="@color/text_1"
                    android:textSize="20sp"
                    android:textStyle="italic|bold" />

            </LinearLayout>

            <!-- Stats: только Избранное + Прогресс (без Собрано) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <!-- Favourites -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/statFavourites"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed"
                        android:text="0"
                        android:textColor="@color/brand_red"
                        android:textSize="28sp"
                        android:textStyle="italic|bold"
                        android:layout_gravity="center"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:letterSpacing="0.06"
                        android:text="@string/profile_stats_favorites"
                        android:textAllCaps="true"
                        android:textColor="@color/text_3"
                        android:textSize="9sp"
                        android:layout_gravity="center"/>
                </LinearLayout>

                <!-- Completion -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/statCompletion"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed"
                        android:text="0%"
                        android:textColor="@color/brand_violet_light"
                        android:textSize="28sp"
                        android:textStyle="italic|bold"
                        android:layout_gravity="center"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:letterSpacing="0.06"
                        android:text="@string/profile_stats_completion"
                        android:textAllCaps="true"
                        android:textColor="@color/text_3"
                        android:textSize="9sp"
                        android:layout_gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Hidden statCollected — kept so ProfileFragment.kt doesn't crash -->
            <TextView
                android:id="@+id/statCollected"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Series progress list -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginBottom="@dimen/spacing_md"
                android:fontFamily="@font/space_grotesk_semibold"
                android:letterSpacing="0.12"
                android:text="@string/home_section_series"
                android:textAllCaps="true"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_label_md" />

            <LinearLayout
                android:id="@+id/progressList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Только Разработчики — без заголовка НАСТРОЙКИ -->
            <LinearLayout
                android:id="@+id/menuDevelopers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:background="@drawable/surface_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_developers"
                    app:tint="@color/text_2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:text="@string/profile_developers"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/text_body_lg" />

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Hidden menu items so ProfileFragment.kt doesn't crash -->
            <LinearLayout
                android:id="@+id/menuSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/menuNotifications"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxl" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>