<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_background"
    tools:context=".ui.favourite_list.FavouriteListFragment">

    <!-- Top header (BarsLogo + Turbo + search) -->
    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_app_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height" />

    <!-- Main content -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/header_height">

        <!-- ── List view ──────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Title block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_xl"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed"
                    android:text="@string/favorites_title"
                    android:textColor="@color/text_1"
                    android:textSize="36sp"
                    android:textStyle="italic|bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/favCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_body_md"
                    tools:text="3 карточки" />
            </LinearLayout>

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_xl"
                android:paddingBottom="@dimen/bottom_nav_height" />
        </LinearLayout>

        <!-- ── Empty state ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xxxl"
            android:paddingEnd="@dimen/spacing_xxxl"
            android:paddingBottom="@dimen/bottom_nav_height"
            android:visibility="gone">

            <!-- Ghost stickers row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="60dp"
                    android:layout_height="80dp"
                    android:background="@drawable/surface_card_bg"
                    android:rotation="-12"
                    android:alpha="0.5" />

                <View
                    android:layout_width="68dp"
                    android:layout_height="92dp"
                    android:layout_marginStart="-12dp"
                    android:background="@drawable/surface_card_bg"
                    android:elevation="2dp" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="-12dp"
                    android:background="@drawable/surface_card_bg"
                    android:rotation="12"
                    android:alpha="0.5" />
            </LinearLayout>

            <!-- Heart icon -->
            <ImageView
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:layout_marginTop="@dimen/spacing_xl"
                android:contentDescription="@null"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/text_3" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/barlow_condensed"
                android:text="@string/favorites_empty_title"
                android:textColor="@color/text_1"
                android:textSize="28sp"
                android:textStyle="italic|bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:text="@string/favorites_empty_subtitle"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_body_md" />

            <!-- CTA -->
            <TextView
                android:id="@+id/btnEmptyCta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_button_height"
                android:layout_marginTop="@dimen/spacing_xl"
                android:background="@drawable/btn_violet_gradient"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/space_grotesk_semibold"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/favorites_empty_cta"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body_lg" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>