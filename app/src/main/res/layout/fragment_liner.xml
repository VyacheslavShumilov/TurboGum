<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_background"
    tools:context=".ui.liner.LinerFragment">

    <!-- Detail header back/title/more -->
    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_detail_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/header_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl">

            <!-- ── Hero image with badges ─────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/bg_surface_2"
                app:cardCornerRadius="@dimen/radius_hero"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_1"
                app:strokeWidth="@dimen/stroke_default">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <!-- Rarity badge top-left -->
                    <TextView
                        android:id="@+id/rarityBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="@dimen/spacing_md"
                        android:background="@drawable/badge_rarity_common"
                        android:fontFamily="@font/space_grotesk"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textAllCaps="true"
                        android:textColor="@color/text_1"
                        android:textFontWeight="600"
                        android:textSize="10sp"
                        android:letterSpacing="0.06"
                        tools:text="Common" />

                    <!-- Year tag top-right -->
                    <TextView
                        android:id="@+id/yearTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/spacing_md"
                        android:background="@drawable/badge_year_bg"
                        android:fontFamily="@font/barlow_condensed"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/text_2"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="1989" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Brand · Model · Number ─────────────────────────── -->
            <TextView
                android:id="@+id/linerBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:fontFamily="@font/space_grotesk"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_body_md"
                tools:text="Opel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/linerModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/barlow_condensed"
                    android:textColor="@color/text_1"
                    android:textSize="36sp"
                    android:textStyle="italic|bold"
                    android:letterSpacing="-0.02"
                    tools:text="Ascona CD" />

                <TextView
                    android:id="@+id/linerNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/barlow_condensed"
                    android:textColor="@color/brand_gold"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="#001" />
            </LinearLayout>

            <!-- Series + year tags row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tagSeries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/surface_input_bg"
                    android:fontFamily="@font/space_grotesk"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/text_2"
                    android:textFontWeight="500"
                    android:textSize="11sp"
                    tools:text="Серия 1" />
            </LinearLayout>

            <!-- ── CTA: Add to collection ─────────────────────────── -->
            <TextView
                android:id="@+id/containerFav"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_button_height"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/btn_cta_gradient"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/detail_add_to_collection"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textFontWeight="600"
                android:textSize="@dimen/text_body_lg" />

            <!-- ── Section: Specs ─────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginBottom="@dimen/spacing_md"
                android:fontFamily="@font/space_grotesk"
                android:letterSpacing="0.12"
                android:text="@string/detail_specs"
                android:textAllCaps="true"
                android:textColor="@color/text_3"
                android:textFontWeight="600"
                android:textSize="@dimen/text_label_md" />

            <!-- Specs 2x2 grid -->
            <GridLayout
                android:id="@+id/specsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <!-- Engine -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:letterSpacing="0.08"
                        android:text="@string/detail_spec_engine"
                        android:textAllCaps="true"
                        android:textColor="@color/text_3"
                        android:textFontWeight="600"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/specEngine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/barlow_condensed"
                        android:textColor="@color/text_1"
                        android:textSize="20sp"
                        android:textStyle="italic|bold"
                        tools:text="1.8L" />
                </LinearLayout>

                <!-- Power -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:letterSpacing="0.08"
                        android:text="@string/detail_spec_power"
                        android:textAllCaps="true"
                        android:textColor="@color/text_3"
                        android:textFontWeight="600"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/specPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/barlow_condensed"
                        android:textColor="@color/text_1"
                        android:textSize="20sp"
                        android:textStyle="italic|bold"
                        tools:text="115 HP" />
                </LinearLayout>

                <!-- Top speed -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:letterSpacing="0.08"
                        android:text="@string/detail_spec_top_speed"
                        android:textAllCaps="true"
                        android:textColor="@color/text_3"
                        android:textFontWeight="600"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/specTopSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/barlow_condensed"
                        android:textColor="@color/text_1"
                        android:textSize="20sp"
                        android:textStyle="italic|bold"
                        tools:text="187 km/h" />
                </LinearLayout>

                <!-- Year -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:letterSpacing="0.08"
                        android:text="@string/detail_spec_year"
                        android:textAllCaps="true"
                        android:textColor="@color/text_3"
                        android:textFontWeight="600"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/specYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/barlow_condensed"
                        android:textColor="@color/text_1"
                        android:textSize="20sp"
                        android:textStyle="italic|bold"
                        tools:text="1981" />
                </LinearLayout>
            </GridLayout>

            <!-- ── Section: Links ─────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginBottom="@dimen/spacing_md"
                android:fontFamily="@font/space_grotesk"
                android:letterSpacing="0.12"
                android:text="@string/detail_links"
                android:textAllCaps="true"
                android:textColor="@color/text_3"
                android:textFontWeight="600"
                android:textSize="@dimen/text_label_md" />

            <!-- Links 2x2 grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <LinearLayout
                    android:id="@+id/containerVk"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/link_card_height"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_link_vk" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/detail_link_vk"
                        android:textColor="@color/text_1"
                        android:textFontWeight="600"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerSociete"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/link_card_height"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_link_societe" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/detail_link_societe"
                        android:textColor="@color/text_1"
                        android:textFontWeight="600"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerVideo"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/link_card_height"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_link_youtube" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/detail_link_video"
                        android:textColor="@color/text_1"
                        android:textFontWeight="600"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerWiki"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/link_card_height"
                    android:layout_columnWeight="1"
                    android:background="@drawable/surface_card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_link_wiki" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/detail_link_wiki"
                        android:textColor="@color/text_1"
                        android:textFontWeight="600"
                        android:textSize="11sp" />
                </LinearLayout>
            </GridLayout>

            <!-- ── Section: Note ──────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginBottom="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/space_grotesk"
                    android:letterSpacing="0.12"
                    android:text="@string/detail_note_section"
                    android:textAllCaps="true"
                    android:textColor="@color/text_3"
                    android:textFontWeight="600"
                    android:textSize="@dimen/text_label_md" />

                <ImageButton
                    android:id="@+id/btnEditNote"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Edit"
                    android:padding="4dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/brand_violet_light" />
            </LinearLayout>

            <!-- Note display (read mode) -->
            <TextView
                android:id="@+id/noteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_card_bg"
                android:fontFamily="@font/space_grotesk"
                android:hint="@string/detail_note_hint"
                android:padding="@dimen/spacing_md"
                android:textColor="@color/text_2"
                android:textColorHint="@color/text_3"
                android:textSize="@dimen/text_body_md" />

            <!-- Note edit (edit mode) -->
            <LinearLayout
                android:id="@+id/noteEditContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone">

                <EditText
                    android:id="@+id/noteEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/space_grotesk"
                    android:hint="@string/detail_note_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:textColor="@color/text_1"
                    android:textColorHint="@color/text_3"
                    android:textSize="@dimen/text_body_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnNoteCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/surface_input_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/space_grotesk"
                        android:gravity="center"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md"
                        android:text="@string/detail_note_cancel"
                        android:textColor="@color/text_2"
                        android:textFontWeight="500"
                        android:textSize="@dimen/text_body_md" />

                    <TextView
                        android:id="@+id/btnNoteSave"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/btn_violet_gradient"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/space_grotesk"
                        android:gravity="center"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md"
                        android:text="@string/detail_note_save"
                        android:textColor="@color/white"
                        android:textFontWeight="600"
                        android:textSize="@dimen/text_body_md" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxl" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>