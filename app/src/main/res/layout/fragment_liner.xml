<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    tools:context=".ui.liner.LinerFragment">

    <!-- ── Top toolbar (transparent overlay on hero image) ─────────────── -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="0dp">

        <ImageButton
            android:id="@+id/toWrappersBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_icon_bg_white"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_icon_bg_white"
            android:src="@drawable/ic_more"
            android:contentDescription="More" />
    </LinearLayout>

    <!-- ── Scrollable content ─────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero image with rounded corners, margin 12dp -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="56dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/placeholder"
                    android:background="@drawable/rounded_hero_bg"
                    android:clipToOutline="true"
                    android:contentDescription="@string/liner_full_size" />



            </FrameLayout>

            <!-- ── Content card sheet ───────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_page"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp">

                <!-- Make -->
                <TextView
                    android:id="@+id/linerBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:fontFamily="@font/font"
                    tools:text="Lancia" />

                <!-- Model -->
                <TextView
                    android:id="@+id/linerModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/font"
                    android:layout_marginBottom="8dp"
                    tools:text="Delta ECV" />

                <!-- Tag row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tagSeries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tag_gray_bg"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp"
                        tools:text="Series T2" />

                    <TextView
                        android:id="@+id/linerNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tag_gray_bg"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        tools:text="109" />
                </LinearLayout>

                <!-- ── Primary CTA: Mark as collected ────────────── -->
                <TextView
                    android:id="@+id/containerFav"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/add_favorite"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:background="@drawable/btn_cta_gradient"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- ── Action links grid ──────────────────────────── -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="12dp"
                    android:useDefaultMargins="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/containerVk"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default"
                        app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/vk" android:layout_marginEnd="7dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/vk_societe" android:textSize="12sp"
                                android:textColor="@color/text_primary" android:fontFamily="@font/font"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/containerSociete"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default"
                        app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/logo_societe" android:layout_marginEnd="7dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/societe_turbo" android:textSize="12sp"
                                android:textColor="@color/text_primary" android:fontFamily="@font/font"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/containerVideo"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default"
                        app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/youtube" android:layout_marginEnd="7dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/video" android:textSize="12sp"
                                android:textColor="@color/text_primary" android:fontFamily="@font/font"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/containerWiki"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default"
                        app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/wikipedia" android:layout_marginEnd="7dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/wiki" android:textSize="12sp"
                                android:textColor="@color/text_primary" android:fontFamily="@font/font"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- ── Specs 2×2 grid ─────────────────────────────── -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="12dp"
                    android:useDefaultMargins="false">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default" app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/spec_engine" android:textSize="10sp"
                                android:textColor="@color/text_hint"/>
                            <TextView android:id="@+id/specEngine"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="15sp" android:textColor="@color/text_primary"
                                android:fontFamily="@font/font" tools:text="4 cyl · 1759 cm³"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default" app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/spec_power" android:textSize="10sp"
                                android:textColor="@color/text_hint"/>
                            <TextView android:id="@+id/specPower"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="15sp" android:textColor="@color/text_primary"
                                android:fontFamily="@font/font" tools:text="600 PS"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default" app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/spec_speed" android:textSize="10sp"
                                android:textColor="@color/text_hint"/>
                            <TextView android:id="@+id/specSpeed"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="15sp" android:textColor="@color/text_primary"
                                android:fontFamily="@font/font" tools:text="310 km/h"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:layout_margin="3dp"
                        app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="10dp"
                        app:strokeColor="@color/border_default" app:strokeWidth="0.5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/spec_number" android:textSize="10sp"
                                android:textColor="@color/text_hint"/>
                            <TextView android:id="@+id/specNumber"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="15sp" android:textColor="@color/text_primary"
                                android:fontFamily="@font/font" tools:text="109"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- Note section (existing feature) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/noteCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="0.5dp">

                    <EditText
                        android:id="@+id/noteTxtView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:padding="12dp"
                        android:hint="@string/add_note"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:background="@null"
                        android:inputType="textMultiLine"
                        android:gravity="top" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- В САМОМ КОНЦЕ fragment_liner.xml,
         как последний дочерний элемент CoordinatorLayout -->


</androidx.coordinatorlayout.widget.CoordinatorLayout>