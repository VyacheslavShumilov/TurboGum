<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_color"
    tools:context=".ui.liner.LinerFragment">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/toolbar_color"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:contentInsetLeft="0dp"
        app:contentInsetStart="0dp"
        app:layout_scrollFlags="scroll|enterAlways">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toWrappersBtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:src="@drawable/btn_wrap_green_line"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_wrap_yellow_line"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:src="@drawable/btn_wrap_blue_line"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:adjustViewBounds="true"
                android:layout_height="match_parent"
                android:src="@drawable/btn_wrap_red_line"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_wrap_txt"
                android:paddingStart="20dp"
                android:scaleType="fitXY"
                android:layout_gravity="center_vertical"
                tools:ignore="RtlSymmetry" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toFavouriteBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginEnd="15dp"
            android:background="@color/transparent"
            app:srcCompat="@drawable/list_fav" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Контейнеры кнопок -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerFav"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_liner_height"
        android:background="@drawable/rounded_container_btn"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/materialDivider3"
        app:layout_constraintStart_toStartOf="@+id/materialDivider3"
        app:layout_constraintEnd_toEndOf="@+id/materialDivider3"
        app:layout_constraintBottom_toTopOf="@+id/containerVk">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_add_favourite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:layout_marginStart="5dp"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_fav" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/fav_txt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:text="@string/add_favorite"
            android:textColor="@color/black"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="start|center"
            android:textSize="@dimen/frag_liner_btn_txt" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerVk"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_liner_height"
        android:background="@drawable/rounded_container_btn"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/containerFav"
        app:layout_constraintStart_toStartOf="@+id/containerFav"
        app:layout_constraintEnd_toEndOf="@+id/containerFav"
        app:layout_constraintBottom_toTopOf="@+id/containerSociete">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/linkVk"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:autoLink="all"
            android:src="@drawable/vk" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/linkVkTxt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:text="@string/vk_societe"
            android:ellipsize="end"
            android:maxLines="2"
            android:gravity="start|center"
            android:textColor="@color/black"
            android:textSize="@dimen/frag_liner_btn_txt" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerSociete"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_liner_height"
        android:background="@drawable/rounded_container_btn"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/containerVk"
        app:layout_constraintStart_toStartOf="@+id/containerFav"
        app:layout_constraintEnd_toEndOf="@+id/containerFav"
        app:layout_constraintBottom_toTopOf="@+id/containerVideo">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/website_societe"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/societe" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/website_societe_txt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:text="@string/societeturbo_com"
            android:gravity="start|center"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/black"
            android:textSize="@dimen/frag_liner_btn_txt" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerVideo"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_liner_height"
        android:background="@drawable/rounded_container_btn"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/containerSociete"
        app:layout_constraintStart_toStartOf="@+id/containerFav"
        app:layout_constraintEnd_toEndOf="@+id/containerFav"
        app:layout_constraintBottom_toTopOf="@+id/containerWiki">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/linkVideo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:autoLink="all"
            android:layout_marginStart="5dp"
            android:src="@drawable/video" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/linkVideo_txt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:text="@string/video"
            android:gravity="start|center"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:textSize="@dimen/frag_liner_btn_txt" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerWiki"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_liner_height"
        android:background="@drawable/rounded_container_btn"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toBottomOf="@+id/containerVideo"
        app:layout_constraintStart_toStartOf="@+id/containerFav"
        app:layout_constraintEnd_toEndOf="@+id/containerFav">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/linkWiki"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:autoLink="all"
            android:layout_marginStart="5dp"
            android:src="@drawable/wiki" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/linkWikiTxt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:text="@string/article"
            android:gravity="start|center"
            android:ellipsize="end"
            android:textColor="@color/black"
            android:textSize="@dimen/frag_liner_btn_txt" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Основное изображение -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/liner_full_size"
        android:elevation="3dp"
        android:src="@drawable/t031"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1.32:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <!-- Индексы -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/linerIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:paddingStart="10dp"
        android:background="@drawable/rounded_liner_index"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="@string/hint_collection"
        android:textColor="@color/black"
        android:textSize="@dimen/frag_fav_liner_index_number"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="@+id/imageView"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/linerNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/liner_txt_color"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="@string/hint_number_liner"
        android:textColor="@color/black"
        android:textSize="@dimen/frag_fav_liner_index_number"
        app:layout_constraintStart_toEndOf="@+id/linerIndex"
        app:layout_constraintTop_toTopOf="@+id/imageView"/>

    <!-- Brand и Model -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/containerBrandModel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@+id/linerNumber"
        app:layout_constraintBottom_toBottomOf="@+id/linerNumber"
        app:layout_constraintStart_toEndOf="@+id/linerNumber"
        app:layout_constraintEnd_toEndOf="@+id/materialDivider3">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/linerBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="7dp"
            android:maxLines="1"
            android:text="@string/hint_brand"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="@dimen/frag_liner_brand_txt"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/linerModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/hint_model"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="@dimen/frag_liner_model_txt"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/materialDivider3"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        android:background="@color/divider_liner_color"
        app:layout_constraintTop_toBottomOf="@+id/linerNumber"
        app:layout_constraintStart_toStartOf="@+id/linerIndex"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Overlay для затемнения фона при увеличении -->
    <View
        android:id="@+id/imageOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Увеличенное изображение -->
    <ImageView
        android:id="@+id/expandedImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:clickable="true" />



</androidx.constraintlayout.widget.ConstraintLayout>
