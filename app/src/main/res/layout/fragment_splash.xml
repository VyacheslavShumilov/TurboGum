<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_background"
    tools:context=".ui.splash.SplashFragment">

    <!-- ════════════════════════════════════════════════════════════════
         GLOW LAYER — root-level absolute halos behind everything else.
         These are siblings of the content LinearLayout, so they don't
         influence the layout / positioning of bars, Turbo, stickers.
         ════════════════════════════════════════════════════════════════ -->

    <!-- Violet halo — large, very soft (sits over Turbo area, slightly above) -->
    <ImageView
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/splash_glow"
        android:translationY="-30dp" />

    <!-- Gold halo — smaller, warmer (sits below Turbo) -->
    <ImageView
        android:layout_width="320dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/splash_glow_gold"
        android:translationY="40dp" />

    <!-- ════════════════════════════════════════════════════════════════
         CONTENT — bars logo, Turbo wordmark, subtitle, 3 stickers.
         User's tuning preserved: 8dp bar widths, custom heights,
         space_grotesk_bold subtitle, letterSpacing=-0.04 on Turbo.
         ════════════════════════════════════════════════════════════════ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Big rounded bars logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="26dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bars_logo_green" />

            <View
                android:layout_width="8dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bars_logo_blue" />

            <View
                android:layout_width="8dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bars_logo_gold" />

            <View
                android:layout_width="8dp"
                android:layout_height="46dp"
                android:background="@drawable/bars_logo_red" />
        </LinearLayout>

        <!-- Turbo wordmark — no glow inside, halos are above at root level -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/barlow_condensed_extrabold_italic"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:text="Turbo"
            android:textColor="@color/brand_gold"
            android:textSize="80sp"
            android:textStyle="bold|italic" />

        <!-- Subtitle: КОЛЛЕКЦИЯ ВКЛАДЫШЕЙ (user's space_grotesk_bold) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:letterSpacing="0.25"
            android:text="КОЛЛЕКЦИЯ ВКЛАДЫШЕЙ"
            android:textAllCaps="true"
            android:textColor="@color/text_3"
            android:textSize="11sp" />

        <!-- 3 sticker thumbnails: tilted -3° / 0 / +3° -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="98dp"
                android:layout_height="74dp"
                android:layout_marginEnd="10dp"
                android:rotation="-3"
                app:cardBackgroundColor="@color/bg_surface_2"
                app:cardCornerRadius="10dp"
                app:cardElevation="6dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/w13" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="98dp"
                android:layout_height="74dp"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="@color/bg_surface_2"
                app:cardCornerRadius="10dp"
                app:cardElevation="8dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/w51" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="98dp"
                android:layout_height="74dp"
                android:rotation="3"
                app:cardBackgroundColor="@color/bg_surface_2"
                app:cardCornerRadius="10dp"
                app:cardElevation="6dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/w329" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>

    <!-- Version pinned at the bottom — populated from BuildConfig.VERSION_NAME -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/spacing_xxxl"
        android:fontFamily="@font/space_grotesk_regular"
        android:letterSpacing="0.08"
        android:textColor="@color/text_4"
        android:textSize="9sp"
        tools:text="v1.0" />
</FrameLayout>