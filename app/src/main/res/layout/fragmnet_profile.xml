<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:orientation="vertical"
    tools:context=".ui.profile.ProfileFragment">

    <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_card"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_profile"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/font" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_icon_bg"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Profile hero ──────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_card"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp"
                android:paddingBottom="14dp">

                <!-- Avatar ring -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/userAvatar"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/ic_baseline_self_improvement_24"
                    android:background="@color/brand_purple_light"
                    app:strokeColor="@color/brand_purple"
                    app:strokeWidth="2dp"
                    app:shapeAppearanceOverlay="@style/circleImageView"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/font"
                    tools:text="Alex Kovalev" />

                <TextView
                    android:id="@+id/userHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginBottom="8dp"
                    tools:text="@turbo_alex · since 2019" />

                <!-- Rank badge -->
                <TextView
                    android:id="@+id/rankBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_purple_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="11sp"
                    android:textColor="@color/brand_purple_dark"
                    android:fontFamily="@font/font"
                    android:layout_marginBottom="12dp"
                    tools:text="★ Platinum Collector" />

                <!-- Stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/stat_chip_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_marginEnd="4dp">
                        <TextView android:id="@+id/statCollected"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="18sp" android:textColor="@color/text_primary"
                            android:fontFamily="@font/font" tools:text="256"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_hint"
                            android:text="@string/stat_collected"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/stat_chip_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_marginEnd="4dp">
                        <TextView android:id="@+id/statFavourites"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="18sp" android:textColor="@color/text_primary"
                            android:fontFamily="@font/font" tools:text="48"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_hint"
                            android:text="@string/stat_favourites"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/stat_chip_bg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <TextView android:id="@+id/statTrades"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="18sp" android:textColor="@color/text_primary"
                            android:fontFamily="@font/font" tools:text="12"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_hint"
                            android:text="@string/stat_trades"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ── Series progress ───────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/series_progress"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/font"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/progressList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <!-- ── Menu items ─────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/font"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menuSettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="0.5dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_settings" android:layout_marginEnd="10dp"
                            app:tint="@color/brand_purple"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings"
                            android:textSize="13sp" android:textColor="@color/text_primary"
                            android:fontFamily="@font/font"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_disabled"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menuNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="0.5dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_notifications" android:layout_marginEnd="10dp"
                            app:tint="@color/brand_purple"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/notifications"
                            android:textSize="13sp" android:textColor="@color/text_primary"
                            android:fontFamily="@font/font"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_disabled"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menuDevelopers"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="0.5dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_developers" android:layout_marginEnd="10dp"
                            app:tint="@color/brand_purple"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/developers"
                            android:textSize="13sp" android:textColor="@color/text_primary"
                            android:fontFamily="@font/font"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_disabled"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>