<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/bg_bottom_nav">

    <!-- PILL (GLOBAL OVERLAY) -->
    <View
        android:id="@+id/nav_pill"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/nav_pill_bg"
        android:translationX="0dp"
        android:layout_marginStart="4dp" />

    <!-- ITEMS -->
    <LinearLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/text_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Главная"
                android:textSize="10sp"
                android:textColor="@color/text_3"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- FAVORITES -->
        <LinearLayout
            android:id="@+id/nav_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_favorites"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_fvorites" />

            <TextView
                android:id="@+id/text_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Избранное"
                android:textSize="10sp"
                android:textColor="@color/text_3"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- NOTES -->
        <LinearLayout
            android:id="@+id/nav_notes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_notes"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_notes" />

            <TextView
                android:id="@+id/text_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Заметки"
                android:textSize="10sp"
                android:textColor="@color/text_3"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_profile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_profile" />

            <TextView
                android:id="@+id/text_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Профиль"
                android:textSize="10sp"
                android:textColor="@color/text_3"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>