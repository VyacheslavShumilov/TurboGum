<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/surface_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <!-- Thumbnail -->
    <ImageView
        android:id="@+id/noteImage"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/surface_input_bg"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:padding="2dp" />

    <!-- Text -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noteModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed"
            android:textColor="@color/text_1"
            android:textSize="18sp"
            android:textStyle="italic|bold"
            tools:text="XK 120 Roadster" />

        <TextView
            android:id="@+id/notePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk"
            android:maxLines="1"
            android:textColor="@color/text_3"
            android:textSize="12sp"
            tools:text="Есть дубликат" />
    </LinearLayout>

    <!-- Chevron -->
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_3"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>