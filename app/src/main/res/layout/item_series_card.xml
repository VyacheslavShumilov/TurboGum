<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_surface_2"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_1"
    app:strokeWidth="@dimen/stroke_default"
    app:rippleColor="#221E2235">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Wrapper image -->
        <ImageView
            android:id="@+id/seriesImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Year tag top-right -->
        <TextView
            android:id="@+id/seriesYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/spacing_sm"
            android:background="@drawable/badge_year_bg"
            android:fontFamily="@font/barlow_condensed_bold"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#D9FFFFFF"
            android:textSize="11sp"
            tools:text="1989" />

        <!-- Bottom dark overlay for legibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/card_overlay_bottom" />

        <!-- Series badge bottom-left -->
        <TextView
            android:id="@+id/seriesBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/spacing_sm"
            android:background="@drawable/badge_violet_bg"
            android:fontFamily="@font/space_grotesk_semibold"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            tools:text="Серия 1" />

        <!-- Count tag bottom-right -->
        <TextView
            android:id="@+id/seriesRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_sm"
            android:background="@drawable/badge_count_bg"
            android:fontFamily="@font/space_grotesk_regular"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#D9FFFFFF"
            android:textSize="10sp"
            tools:text="50 шт" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>