<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="true"
    app:strokeColor="@color/border_default"
    app:strokeWidth="0.5dp"
    app:rippleColor="#221E2235">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image area with shimmer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Shimmer placeholder -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:shimmer_base_color="#1E2235"
                app:shimmer_highlight_color="#2A2D45"
                app:shimmer_auto_start="true"
                app:shimmer_duration="1000">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@color/surface_input" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Real image — hidden until loaded -->
            <ImageView
                android:id="@+id/seriesImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:clipToOutline="true"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Card body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/seriesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/font" />

            <TextView
                android:id="@+id/seriesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/seriesChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_purple_bg"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>