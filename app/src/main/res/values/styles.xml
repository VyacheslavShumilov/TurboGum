<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════ DISPLAY (Barlow Condensed Italic) ═══════════════════ -->
    <style name="Text.Display.Large" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">italic|bold</item>
        <item name="android:textSize">@dimen/text_display_lg</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Display.Medium" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">italic|bold</item>
        <item name="android:textSize">@dimen/text_display_md</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <!-- ═══════════════════ HEADLINE ═══════════════════ -->
    <style name="Text.Headline.Large" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">italic|bold</item>
        <item name="android:textSize">@dimen/text_headline_lg</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <style name="Text.Headline.Medium" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">italic|bold</item>
        <item name="android:textSize">@dimen/text_headline_md</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <style name="Text.Headline.Small" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_headline_sm</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <!-- ═══════════════════ TITLE ═══════════════════ -->
    <style name="Text.Title.Large" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_title_lg</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <!-- ═══════════════════ BODY (Space Grotesk) ═══════════════════ -->
    <style name="Text.Body.Large" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <style name="Text.Body.Medium" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">@dimen/text_body_md</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="Text.Body.Small" parent="">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_3</item>
    </style>

    <!-- ═══════════════════ LABEL ═══════════════════ -->
    <!-- Use semibold font variant directly (textFontWeight needs API 28) -->
    <style name="Text.Label.Large" parent="">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">@dimen/text_label_lg</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.Label.Medium" parent="">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">@dimen/text_label_md</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Label.Small" parent="">
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textSize">@dimen/text_label_sm</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <!-- ═══════════════════ SPECIALIZED TEXT ═══════════════════ -->
    <style name="Text.CardNumber" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brand_gold</item>
    </style>

    <style name="Text.SeriesNumber" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">italic|bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/brand_gold</item>
    </style>

    <style name="Text.StatValue" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">italic|bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_1</item>
    </style>

    <style name="Text.SectionLabel" parent="Text.Label.Medium">
        <item name="android:textColor">@color/text_3</item>
    </style>

    <!-- ═══════════════════ COMPONENT STYLES ═══════════════════ -->
    <style name="TurboBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_selector</item>
        <item name="itemTextColor">@color/nav_selector</item>
        <item name="backgroundTint">@color/bg_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/TurboNavIndicator</item>
        <item name="elevation">8dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="TurboNavIndicator" parent="@style/Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:height">0dp</item>
        <item name="android:width">0dp</item>
    </style>

    <style name="TurboToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/bg_background</item>
        <item name="android:elevation">2dp</item>
        <item name="contentInsetStart">0dp</item>
        <item name="contentInsetLeft">0dp</item>
    </style>

    <style name="TurboBadge" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/badge_violet_bg</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- ═══════════════════ SHAPE APPEARANCE ═══════════════════ -->
    <style name="ShapeAppearance.TurboCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">@dimen/radius_lg</item>
        <item name="cornerSizeBottomRight">@dimen/radius_lg</item>
    </style>

    <style name="ShapeAppearance.TurboCard.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>