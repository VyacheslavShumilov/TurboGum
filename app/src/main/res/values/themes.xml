<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TurboGum" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorPrimaryVariant">@color/brand_purple_active</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_orange</item>
        <item name="colorSecondaryVariant">@color/brand_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/surface_page</item>
        <item name="android:navigationBarColor">@color/surface_page</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:fontFamily">@font/font</item>
        <item name="android:windowBackground">@color/surface_page</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Theme.TurboGum.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TurboBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_selector</item>
        <item name="itemTextColor">@color/nav_selector</item>
        <item name="backgroundTint">@color/surface_card</item>
        <item name="elevation">8dp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
    </style>

    <style name="TurboToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/surface_page</item>
        <item name="android:elevation">2dp</item>
        <item name="contentInsetStart">0dp</item>
        <item name="contentInsetLeft">0dp</item>
    </style>

    <style name="TurboBadge">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/brand_purple_dark</item>
        <item name="android:background">@drawable/badge_purple_bg</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="Theme.TurboGum.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.TurboGum.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>